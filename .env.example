DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# --- Nosana-hosted Coder model (bigger model, proposes the patch) ---
# Base URL must be the full OpenAI-compatible root, e.g. http://<job-address>/v1
# Template: "Qwen 3.6" (35B-A3B, MoE), served via docker.io/ollama/ollama.
# NOTE: Ollama's OpenAI-compat API expects the exact tag it pulled (e.g.
# "qwen3.6:35b-a3b"), not a Hugging Face-style name. After deploying, confirm
# the real tag with: curl <NOSANA_CODER_BASE_URL>/models
NOSANA_CODER_BASE_URL=https://5etRrCPAjgUiXA4fLcigRs3hd3JCnnRQX6xyK8ryhj9o.node.k8s.prd.nos.ci
NOSANA_CODER_API_KEY=EDHYjUmMDggRc2fCdbd83xVE2JBF1hBAX3UW3VNiKMTf
NOSANA_CODER_MODEL=qwen3.6:35b-a3b-q8_0

# --- Nosana-hosted Critic model (smaller/cheaper, checks for cheating) ---
# Template: "GLM-4.7-Flash" (Q4_K_M) - deliberately a different model family
# from the Coder, so the critic doesn't share the Coder's blind spots.
# Leave blank to reuse the Coder endpoint/key for the critic too.
NOSANA_CRITIC_BASE_URL=https://2DmcYLcZqZRAv9MvWwmkEuCSp67yPiAUSdqyTm3mQW5V.node.k8s.prd.nos.ci
NOSANA_CRITIC_API_KEY=125EyWbABAmBcbJEb8uPQmsiD5Z3abEBAY8ojkquckV
NOSANA_CRITIC_MODEL=glm-4.7-flash:bf16

# --- Loop ---
MAX_ITERATIONS=4
